{
  "schema": "uranometria.deep-sky-survey-layer.v0.1",
  "purpose": "Bridge the local 2MASS/2MRS universe to deep-field and LRD observations without implying isotropic observational coverage.",
  "coordinate_frame": "ICRS",
  "radial_coordinate": {
    "preferred": "cosmological comoving distance",
    "observed_quantity": "redshift",
    "retain_observed_redshift": true
  },
  "render_policy": {
    "footprints_are_data": true,
    "preserve_selection_function": true,
    "preserve_redshift_quality": true,
    "do_not_fill_unobserved_sky": true,
    "mobile": "stream/chunk by survey, sky tile and redshift bin"
  },
  "survey_layers": [
    {
      "id": "2mrs",
      "label": "2MASS Redshift Survey",
      "role": "nearby all-sky scaffold",
      "legacy_colour": "base",
      "spectroscopic": true
    },
    {
      "id": "6dfgs",
      "label": "6dF Galaxy Survey",
      "legacy_colour": "yellow",
      "spectroscopic": true
    },
    {
      "id": "2dfgrs",
      "label": "2dF Galaxy Redshift Survey",
      "legacy_colour": "red",
      "spectroscopic": true
    },
    {
      "id": "sdss",
      "label": "Sloan Digital Sky Survey",
      "legacy_colour": "purple",
      "spectroscopic": true
    },
    {
      "id": "gama",
      "label": "Galaxy And Mass Assembly",
      "legacy_colour": "green",
      "spectroscopic": true
    },
    {
      "id": "wigglez",
      "label": "WiggleZ Dark Energy Survey",
      "legacy_colour": "blue",
      "spectroscopic": true
    },
    {
      "id": "des",
      "label": "Dark Energy Survey",
      "role": "deep wide-field imaging / photometric-redshift scaffold",
      "legacy_colour": "orange",
      "spectroscopic": false
    },
    {
      "id": "ozdes",
      "label": "OzDES",
      "role": "spectroscopic follow-up of DES fields and transients",
      "legacy_colour": "orange",
      "spectroscopic": true
    },
    {
      "id": "desi",
      "label": "Dark Energy Spectroscopic Instrument",
      "role": "large-scale 3D spectroscopic redshift / cosmic-web layer",
      "legacy_colour": "distinct-from-DES",
      "spectroscopic": true
    }
  ],
  "next_depth_tiers": [
    "COSMOS / COSMOS-Web",
    "Hubble Ultra Deep Field / XDF",
    "CANDELS",
    "CEERS",
    "JADES",
    "UNCOVER",
    "PRIMER",
    "RUBIES",
    "LRD catalogues"
  ],
  "principle": "Survey colour is a display convention; survey footprint, selection, redshift provenance and quality are scientific data.",
  "visual_encoding": {
    "wavelength_colour": {
      "mode": "physical-spectrum-family",
      "bands": [
        {
          "id": "radio",
          "range": "radio",
          "display": "long-wavelength spectral endpoint"
        },
        {
          "id": "microwave",
          "range": "microwave",
          "display": "microwave"
        },
        {
          "id": "infrared",
          "range": "infrared",
          "display": "beyond-visible red / IR"
        },
        {
          "id": "visible",
          "range": "380–700 nm",
          "display": "spectral colour by effective wavelength"
        },
        {
          "id": "ultraviolet",
          "range": "ultraviolet",
          "display": "beyond-visible violet / UV"
        },
        {
          "id": "xray",
          "range": "X-ray",
          "display": "short-wavelength endpoint"
        }
      ],
      "rule": "For broadband observations retain filter/band metadata; never assign a fictitious single wavelength."
    },
    "survey_controls": {
      "mode": "multi-toggle",
      "independent": true,
      "compare": true
    },
    "overlap": {
      "rule": "An astrophysical object cross-matched in >=2 currently enabled surveys renders white.",
      "minimum_enabled_surveys": 2,
      "display": "white",
      "retain_memberships_on_select": true
    },
    "crossmatch": {
      "identity": "canonical astrophysical object id plus coordinate/redshift-aware catalogue crossmatch",
      "never": "match by display label alone"
    },
    "accessibility": {
      "wavelength": "also encode band/filter text; colour is not the sole carrier of wavelength information"
    }
  }
}
